{
	"name": "merkushin/wpal",
	"version": "0.6.1",
	"description": "Provides an abstraction layer for WordPress API",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Merkushin\\Wpal\\": "src/"
		}
	},
	"authors": [
		{
			"name": "Dmitry Merkushin",
			"email": "merkushin@gmail.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpcs": "phpcs",
		"check": [
			"@test",
			"@phpstan",
			"@phpcs"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
