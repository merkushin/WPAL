{
	"name": "merkushin/wpal",
	"version": "0.8.0",
	"description": "Provides an abstraction layer for WordPress API",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"Merkushin\\Wpal\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Merkushin\\Wpal\\Tools\\": "tools/",
			"Merkushin\\Wpal\\Tests\\Tools\\": "tests/Tools/",
			"Merkushin\\Wpal\\Tests\\Api\\": "tests/Api/"
		}
	},
	"authors": [
		{
			"name": "Dmitry Merkushin",
			"email": "merkushin@gmail.com"
		}
	],
	"bin": [
		"bin/wpal-prune"
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"nikic/php-parser": "^5.6",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": [
			"@php bin/split-stubs.php vendor/php-stubs/wordpress-stubs/wordpress-stubs.php build/wordpress-stubs",
			"phpstan analyse --memory-limit=512M",
			"phpstan analyse --memory-limit=512M -c phpstan-api.neon.dist",
			"phpstan analyse --memory-limit=512M -c phpstan-tools.neon.dist"
		],
		"phpcs": "phpcs",
		"check": [
			"@test",
			"@phpstan",
			"@phpcs"
		],
		"wpal": "@php bin/wpal"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
