<?xml version="1.0"?>
<ruleset name="WPAL">
	<description>Keeps the Service layer compatible with PHP 7.4, WordPress's minimum.</description>

	<file>src/Service</file>
	<file>src/ServiceFactory.php</file>
	<!-- The Api entry point must parse on PHP 7.4 to report the version requirement. -->
	<file>src/Wpal.php</file>
	<!-- wpal-prune ships with the package and runs on plugins' build machines. -->
	<file>bin/Pruner.php</file>
	<file>bin/wpal-prune</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- src/Api needs PHP 8.4 and is checked by phpstan-api.neon.dist instead. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibility">
		<!-- Flags mysql2date() as the removed mysql_ extension. -->
		<exclude name="PHPCompatibility.Extensions.RemovedExtensions.mysql_DeprecatedRemoved"/>
	</rule>
</ruleset>
